[general]
# Cleanup commits are rejected by the range invocations only (Makefile
# test-gitlint, .github/workflows/base-commit-message-checker.yml): the commit-msg
# hook lints with this file alone and must keep accepting `git commit --fixup`,
# so ignore-*-commits=false never goes here.
contrib=contrib-title-conventional-commits,contrib-disallow-cleanup-commits
ignore=body-min-length,body-is-missing
regex-style-search=True

[ignore-body-lines]
# Accept lines stating only a long unwrappable URL
regex=^https?:\/\/\S+$

[ignore-by-title]
# "git subrepo" creates automatic, non-conventional commits we need to accept
# https://progress.opensuse.org/issues/198254
regex=^(git subrepo pull|(chore|build)\(deps(-dev)?\): bump)
ignore=all
